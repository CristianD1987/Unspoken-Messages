{
  "expo": {
    "name": "Unspoken Therapy",
    "slug": "unspoken-therapy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_portocaliu.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo_portocaliu.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1E1E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unspokentherapy.app",
      "infoPlist": {
        "NSContactsUsageDescription": "Unspoken needs access to contacts to help you select people to write messages to.",
        "NSFaceIDUsageDescription": "Allow Unspoken to use Face ID to protect your private messages.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_portocaliu.png",
        "backgroundColor": "#1E1E1E"
      },
      "package": "com.unspokentherapy.app",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/logo_portocaliu.png"
    },
    "plugins": [
      "expo-contacts",
      "expo-local-authentication",
      "expo-image-picker",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "15ee8c5f-5eb1-4336-86a6-ea87d4403f47"
      }
    }
  }
}
