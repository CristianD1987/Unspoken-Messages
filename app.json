{
  "expo": {
    "name": "Unspoken",
    "slug": "unspoken-therapy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/unspoken-icon/icon-ios.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/unspoken-icon/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111320"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unspokentherapy.app",
      "infoPlist": {
        "CFBundleDisplayName": "Unspoken",
        "NSContactsUsageDescription": "Unspoken uses your contacts only when you pick someone to write to. Nothing is uploaded.",
        "NSFaceIDUsageDescription": "Unspoken uses Face ID to keep your messages private.",
        "NSPhotoLibraryUsageDescription": "Unspoken uses your photos only when you choose a picture for a conversation. It stays encrypted on your device.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "label": "Unspoken",
      "adaptiveIcon": {
        "foregroundImage": "./assets/unspoken-icon/adaptive-foreground.png",
        "backgroundImage": "./assets/unspoken-icon/adaptive-background.png",
        "monochromeImage": "./assets/unspoken-icon/adaptive-monochrome.png",
        "backgroundColor": "#111320"
      },
      "package": "com.unspokentherapy.app",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/unspoken-icon/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/unspoken-icon/splash-logo.png",
          "imageWidth": 200,
          "backgroundColor": "#111320",
          "dark": {
            "image": "./assets/unspoken-icon/splash-logo.png",
            "backgroundColor": "#111320"
          }
        }
      ],
      "expo-contacts",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Unspoken uses your photos only when you choose a picture for a conversation. It stays encrypted on your device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "15ee8c5f-5eb1-4336-86a6-ea87d4403f47"
      }
    }
  }
}
