{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "client/src/*"
      ],
      "@assets/*": [
        "assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "server",
    "shared",
    "vite.config.ts",
    "drizzle.config.ts",
    "tailwind.config.ts",
    "client/src/components/ui",
    "client/src/main.tsx"
  ]
}
